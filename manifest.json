{
  "manifest_version": 3,
  "name": "LeetCode Friends",
  "version": "1.1.4",
  "description": "LeetCode Friends lets you track friends' LeetCode progress in a glance, right from within leetcode.com.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://leetcode-friends.duckdns.org/*"],
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": [
        "content.js",
        "match.js"
      ]
    },
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["vendor/pyright-client.js", "vendor/lodash-types.js", "vendor/python-stubs.js", "autocomplete.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["autocomplete-config.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["username_obtainer.js", "popup_content.html", "submission_interceptor.js", "vendor/pyright-worker.js"],
      "matches": ["https://leetcode.com/*"]
    }
  ]
}
